%% Open Local Assistant - Core Domain Model
%% Class diagram of the types that cross the IPC boundary or define the domain.
%% Rust type names are used verbatim; the wire format is camelCase
%% (serde rename_all = "camelCase" on every type below).
%% Generics are written with the Mermaid ~...~ notation.
%% Companion diagrams: architecture.mmd, dataflow.mmd, sequence.mmd.

classDiagram
    direction TB

    %% ==================================================================
    %% Process state
    %% ==================================================================
    namespace STATE["Process state (state.rs)"] {

        class AppState {
            +paths: AppPaths
            +db: Arc~Db~
            +settings: Arc~SettingsStore~
            +lmstudio: Arc~LmStudioService~
            +resolver: Arc~ModelResolver~
            +chat: Arc~ChatEngine~
            +attachments: Arc~AttachmentStore~
            +mcp: Arc~McpManager~
            +web_search: Arc~WebSearch~
            +models: Arc~ModelStore~
            +stt: Arc~SttService~
            +tts: Arc~TtsService~
            +voice: Arc~VoiceSessions~
            +hardware: HardwareInfo
            +downloads: Mutex~HashMap~String~CancellationToken~
            +model_loading: Mutex~HashSet~String~~
            +dictation_busy: AtomicBool
            +dictation_cancel: AtomicBool
            +dictation_live_typer: LiveTyper
            +dictation_review: Mutex~Option~ReviewPending~~
            +dictation_target: AtomicIsize
            +shortcut_errors: Mutex~Vec~String~~
            +capabilities() LocalCapabilityManager
        }

        class AppPaths {
            +data_dir: PathBuf
            +models_dir: PathBuf
            +logs_dir: PathBuf
            +database: PathBuf
        }
    }

    note for AppState "22 fields: 12 Arc service singletons, 1 value type (HardwareInfo),<br/>4 std Mutex maps or sets, 2 AtomicBool flags, 1 AtomicIsize<br/>(native window handle), 1 LiveTyper, 1 Option review slot, 1 error Vec.<br/>Every std lock is poison-tolerant: lock().unwrap_or_else into_inner."

